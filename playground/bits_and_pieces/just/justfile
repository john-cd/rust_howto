# Print the absolute working-directory path for this Just example.
@pwd:
    echo '{{ absolute_path(".") }}'

# Print the Just executable and directory paths used by this example.
@test:
    echo '{{ just_executable() }}'
    echo '{{ justfile() }}'
    echo '{{ justfile_directory() }}'
    echo '{{ source_directory() }}'
    echo '{{ invocation_directory() }}'

# make [script] work

set unstable

set script-interpreter := ["C:\\cygwin64\\bin\\bash.exe", "-u"]

# Demonstrate Windows script recipes and print the Just executable and directory paths.
[script]
[windows]
@test2:
    echo '{{ just_executable() }}'
    echo '{{ justfile() }}'
    echo '{{ justfile_directory() }}'
    echo '{{ source_directory() }}'
    echo '{{ invocation_directory() }}'
    PATH="/bin:$PATH" && echo "$PATH"; pwd

