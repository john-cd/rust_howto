// TODO Reviewed ??-??-2026

//! Recognizes CommonMark 0.31.2 link syntax and the book's URL/directive extensions.
//!
//! This is a syntax grammar, not a complete CommonMark block or inline parser. The caller must
//! supply remaining block context, resolve reference labels (Unicode case folding, whitespace
//! normalization, the 999-character limit, and first-definition precedence), and reject nested
//! links. Code spans, autolinks, and raw HTML are recognized inside link text because they take
//! precedence over its bracket delimiters. See <https://spec.commonmark.org/0.31.2/> sections 4.2,
//! 4.5, 4.7, 6.3, 6.4, 6.5, and 6.6.
//!
//! commonmark_link_candidate recognizes reference-link syntax even when its label has no matching
//! definition. A caller must resolve it before treating it as a link. repository_bare_url,
//! hidden_text, and the book directives are project extensions; CommonMark does not turn bare URLs
//! into autolinks.

document = {
    SOI
    ~ (
        atx_heading_opening
        | hidden_text
        | reference_definition
        | fenced_code_block
        | code_span
        | unmatched_backtick_run
        | raw_html_inline
        | backslash_escape
        | commonmark_link_candidate
        | commonmark_autolink
        | repository_bare_url
        | include_directive
        | crate_directive
        | source_char
    )*
    ~ EOI
}

// CommonMark link candidates

commonmark_link_candidate = _{
    image_inline_link
    | image_full_reference_link
    | image_collapsed_reference_link
    | image_shortcut_reference_candidate
    | inline_link
    | full_reference_link
    | collapsed_reference_link
    | shortcut_reference_candidate
}

// A link text may be empty and may contain balanced brackets. Inline parsing of emphasis is left to
// the caller; escaped brackets, code spans, autolinks, raw HTML tags, and images are recognized here.
link_text = { "[" ~ link_text_item* ~ "]" }

link_text_item = _{
    backslash_escape
    | code_span
    | unmatched_backtick_run
    | commonmark_autolink
    | raw_html_inline
    | image_inline_link
    | image_full_reference_link
    | image_collapsed_reference_link
    | image_shortcut_reference_candidate
    | balanced_bracket_text
    | !("[" | "]") ~ ANY
}

balanced_bracket_text = { "[" ~ link_text_item* ~ "]" }

inline_link = { link_text ~ inline_link_suffix }
image_inline_link = { "!" ~ link_text ~ inline_link_suffix }

inline_link_suffix = {
    "("
    ~ (
        link_title_only
        | inline_whitespace ~ link_destination ~ (title_separator ~ link_title)? ~ inline_whitespace
        | inline_whitespace
    )
    ~ ")"
}

// If a title follows an opening parenthesis without a destination, whitespace is required. Without
// that whitespace, a quoted string is parsed as the link destination, as CommonMark specifies.
link_title_only = { title_separator ~ link_title ~ inline_whitespace }

full_reference_link = { link_text ~ link_label }
image_full_reference_link = { "!" ~ link_text ~ link_label }

collapsed_reference_link = { link_text ~ "[]" }
image_collapsed_reference_link = { "!" ~ link_text ~ "[]" }

shortcut_reference_candidate = { link_text ~ !("(" | "[]" | link_label) }
image_shortcut_reference_candidate = { "!" ~ link_text ~ !("(" | "[]" | link_label) }

// A reference label cannot be empty or contain unescaped brackets. Its exact length and normalized
// value must be checked by the caller because those rules depend on Unicode-aware document state.
link_label = {
    "[" ~ link_label_space* ~ link_label_nonspace ~ link_label_char* ~ "]"
}
link_label_space = _{ SP | line_ending }
link_label_nonspace = _{
    backslash_escape
    | !("[" | "]" | SP | line_ending) ~ ANY
}
link_label_char = _{ backslash_escape | !("[" | "]") ~ ANY }

// Inline destinations and titles

inline_whitespace = _{ SP* ~ line_ending? ~ SP* }
title_separator = _{ SP+ ~ line_ending? ~ SP* | line_ending ~ SP* }

link_destination = { angle_link_destination | bare_link_destination }

angle_link_destination = {
    "<" ~ angle_destination_character* ~ ">"
}
angle_destination_character = _{
    backslash_escape
    | !(line_ending | "<" | ">") ~ ANY
}

bare_link_destination = {
    !"<"
    ~ (
        backslash_escape
        | balanced_destination_parentheses
        | bare_destination_character
    )+
}
balanced_destination_parentheses = {
    "("
    ~ (
        backslash_escape
        | balanced_destination_parentheses
        | !(ascii_control | SP | "<" | ">" | "(" | ")") ~ ANY
    )*
    ~ ")"
}
bare_destination_character = _{
    !(ascii_control | SP | "<" | ">" | "(" | ")") ~ ANY
}

link_title = {
    double_quoted_title
    | single_quoted_title
    | parenthesized_title
}
double_quoted_title = {
    "\""
    ~ (backslash_escape | !("\"" | blank_line) ~ ANY)*
    ~ "\""
}
single_quoted_title = {
    "'"
    ~ (backslash_escape | !("'" | blank_line) ~ ANY)*
    ~ "'"
}
parenthesized_title = {
    "("
    ~ (backslash_escape | !("(" | ")" | blank_line) ~ ANY)*
    ~ ")"
}
blank_line = _{ line_ending ~ SP* ~ line_ending }

// Link reference definitions

// This production includes the preceding line ending so the document scanner can recognize a
// definition at a line boundary without a lookbehind. The definition body stops before its ending.
reference_definition = { (SOI | line_ending) ~ reference_definition_body }
reference_definition_body = {
    " "{0,3}
    ~ link_label
    ~ ":"
    ~ definition_whitespace
    ~ link_destination
    ~ (
        title_separator ~ link_title ~ SP* ~ line_end
        | SP* ~ line_end
    )
}
definition_whitespace = _{ SP* ~ line_ending? ~ SP* }
line_end = _{ &line_ending | &EOI }

// CommonMark autolinks

commonmark_autolink = { "<" ~ (uri_autolink | email_autolink) ~ ">" }

uri_autolink = {
    uri_scheme ~ ":" ~ uri_autolink_character*
}
uri_scheme = @{
    ASCII_ALPHA
    ~ (ASCII_ALPHA | ASCII_DIGIT | "+" | "." | "-"){1,31}
}
uri_autolink_character = _{
    !(ascii_control | SP | "<" | ">") ~ ANY
}

email_autolink = { email_address }
email_address = {
    email_local_part ~ "@" ~ email_domain_label ~ ("." ~ email_domain_label)*
}
email_local_part = @{
    email_local_character+
}
email_local_character = _{
    ASCII_ALPHANUMERIC
    | "." | "!" | "#" | "$" | "%" | "&" | "'" | "*" | "+"
    | "/" | "=" | "?" | "^" | "_" | "\u{0060}" | "{" | "|" | "}" | "~" | "-"
}
email_domain_label = {
    ASCII_ALPHANUMERIC
    | ASCII_ALPHANUMERIC
        ~ (ASCII_ALPHANUMERIC | "-"){0,61}
        ~ ASCII_ALPHANUMERIC
}

// CommonMark fenced code blocks

// A fenced block is recognized at a document line boundary so link-looking content is not scanned.
// The caller still handles container-block indentation and other block-level precedence.
fenced_code_block = _{ backtick_fenced_code_block | tilde_fenced_code_block }
backtick_fenced_code_block = {
    (SOI | line_ending)
    ~ " "{0,3}
    ~ PUSH("`"{3,})
    ~ (!"`" ~ !line_ending ~ ANY)*
    ~ (line_ending | EOI)
    ~ (!backtick_fence_closing_line ~ fenced_code_body_line)*
    ~ backtick_fence_close?
}
tilde_fenced_code_block = {
    (SOI | line_ending)
    ~ " "{0,3}
    ~ PUSH("~"{3,})
    ~ (!line_ending ~ ANY)*
    ~ (line_ending | EOI)
    ~ (!tilde_fence_closing_line ~ fenced_code_body_line)*
    ~ tilde_fence_close?
}
backtick_fence_closing_line = _{
    " "{0,3} ~ PEEK ~ "`"* ~ SP* ~ line_end
}
backtick_fence_close = _{
    " "{0,3} ~ POP ~ "`"* ~ SP* ~ line_end
}
tilde_fence_closing_line = _{
    " "{0,3} ~ PEEK ~ "~"* ~ SP* ~ line_end
}
tilde_fence_close = _{
    " "{0,3} ~ POP ~ "~"* ~ SP* ~ line_end
}
fenced_code_body_line = _{
    line_ending
    | (!line_ending ~ ANY)+ ~ (line_ending | EOI)
}

// CommonMark code spans

// PUSH/PEEK/POP ensure the closing backtick run has exactly the opening run's length. A longer or
// shorter run inside the code span is consumed as content, rather than being mistaken for a close.
code_span = @{
    PUSH("\u{0060}"+)
    ~ code_span_character*
    ~ POP
}
code_span_character = _{
    nonmatching_backtick_run
    | !"\u{0060}" ~ ANY
}
unmatched_backtick_run = { "\u{0060}"+ }
nonmatching_backtick_run = _{
    PEEK ~ "\u{0060}"+
    | !PEEK ~ "\u{0060}"+
}

// CommonMark inline HTML tags, which take precedence over brackets in link text

raw_html_inline = _{
    html_comment
    | html_processing_instruction
    | html_declaration
    | html_cdata_section
    | html_closing_tag
    | html_opening_tag
}
html_opening_tag = {
    "<"
    ~ html_tag_name
    ~ (html_whitespace ~ html_attribute)*
    ~ html_whitespace?
    ~ "/"?
    ~ ">"
}
html_closing_tag = { "</" ~ html_tag_name ~ html_whitespace? ~ ">" }
html_tag_name = @{
    ASCII_ALPHA ~ (ASCII_ALPHA | ASCII_DIGIT | "-")*
}
html_attribute = {
    html_attribute_name
    ~ (
        html_optional_whitespace
        ~ "="
        ~ html_optional_whitespace
        ~ html_attribute_value
    )?
}
html_attribute_name = @{
    (ASCII_ALPHA | "_" | ":")
    ~ (ASCII_ALPHANUMERIC | "_" | "." | ":" | "-")*
}
html_attribute_value = _{
    html_unquoted_attribute_value
    | html_single_quoted_attribute_value
    | html_double_quoted_attribute_value
}
html_unquoted_attribute_value = @{
    (!(" " | "\t" | line_ending | "\"" | "'" | "=" | "<" | ">" | "\u{0060}") ~ ANY)+
}
html_single_quoted_attribute_value = { "'" ~ (!"'" ~ ANY)* ~ "'" }
html_double_quoted_attribute_value = { "\"" ~ (!"\"" ~ ANY)* ~ "\"" }
html_whitespace = _{ SP+ ~ line_ending? ~ SP* | line_ending ~ SP* }
html_optional_whitespace = _{ SP* ~ line_ending? ~ SP* }
html_comment = {
    "<!-->"
    | "<!--->"
    | "<!--" ~ (!"-->" ~ ANY)* ~ "-->"
}
html_processing_instruction = { "<?" ~ (!"?>" ~ ANY)* ~ "?>" }
html_declaration = { "<!" ~ ASCII_ALPHA ~ (!">" ~ ANY)* ~ ">" }
html_cdata_section = { "<![CDATA[" ~ (!"]]>" ~ ANY)* ~ "]]>" }

// CommonMark ATX headings (§4.2). The document scanner consumes only the opening marker so it can
// continue recognizing links in the heading's inline content. Call atx_heading at line start when
// the complete heading span is needed.
atx_heading_opening = {
    (SOI | line_ending)
    ~ " "{0,3}
    ~ "#"{1,6}
    ~ &(SP | line_ending | EOI)
}
atx_heading = {
    " "{0,3}
    ~ "#"{1,6}
    ~ &(SP | line_ending | EOI)
    ~ atx_heading_content
    ~ atx_heading_closing?
    ~ (line_ending | EOI)
}
atx_heading_content = @{ (!atx_heading_closing ~ !line_ending ~ ANY)* }
atx_heading_closing = { SP+ ~ "#"+ ~ SP* ~ line_end }

// mdBook directives are repository extensions, not CommonMark syntax.

include_directive = {
    "{{" ~ SP* ~ "#" ~ SP* ~ "include" ~ SP+ ~ directive_argument ~ "}}"
}
crate_directive = {
    "{{" ~ SP* ~ "#" ~ SP* ~ "crate" ~ SP+ ~ directive_argument ~ "}}"
}
directive_argument = @{ (!(line_ending | "}}") ~ ANY)+ }

// Preserve the book's special hidden div behavior from the original grammar.
hidden_text = _{
    "<div class=\"hidden\">"
    ~ (!"</div>" ~ ANY)*
    ~ "</div>"
    ~ SP*
    ~ line_ending
}

// Backslash escapes are limited to ASCII punctuation by CommonMark.
backslash_escape = { "\\" ~ ascii_punctuation }
ascii_punctuation = _{
    "!" | "\"" | "#" | "$" | "%" | "&" | "'"
    | "(" | ")" | "*" | "+" | "," | "-" | "." | "/"
    | ":" | ";" | "<" | "=" | ">" | "?" | "@"
    | "[" | "\\" | "]" | "^" | "_" | "\u{0060}"
    | "{" | "|" | "}" | "~"
}
ascii_control = _{ '\u{00}'..'\u{1F}' | "\u{007F}" }
SP = _{ " " | "\t" }
line_ending = _{ "\r\n" | "\n" | "\r" }

// Repository-specific bare URL recognition. These are not CommonMark autolinks.

repository_bare_url = {
    issue_url | github_url | crates_url | lib_url | docs_url | general_url
}

// Example: https://github.com/john-cd/rust_howto/issues/602
issue_url = { http ~ "github.com/john-cd/rust_howto/issues/" ~ ASCII_DIGIT+ }

// github.com URLs other than issue URLs
// Example: https://github.com/rustdesk/rustdesk
github_url = { github_url_prefix ~ ("/" ~ org) ~ ("/" ~ repo)? ~ end_of_url? }
github_url_prefix = _{ http ~ "github.com" }
org = @{ (!"/" ~ ANY)+ }
repo = @{ (!"/" ~ ANY)+ }

// crates.io URLs
crates_url = { crate_url_prefix ~ "/" ~ crate_name ~ end_of_url? }
crate_url_prefix = _{ http ~ "crates.io/crates" }

// lib.rs URLs
lib_url = { lib_url_prefix ~ ("/" ~ crate_name)? ~ end_of_url? }
lib_url_prefix = _{ http ~ "lib.rs/crates" }

// docs.rs URLs
docs_url = { docs_url_prefix ~ ("/" ~ crate_name)? ~ end_of_url? }
docs_url_prefix = _{ http ~ "docs.rs" }

crate_name = @{ (ASCII_ALPHANUMERIC | "-" | "_")+ }
http = _{ "http" ~ "s"? ~ "://" }
host = { ASCII_ALPHANUMERIC+ ~ ("." ~ ASCII_ALPHANUMERIC+)* }
port = _{ ":" ~ ASCII_DIGIT+ }
path = { "/" ~ (!("?" | "#") ~ url_character)* }
query = { "?" ~ (!"?" ~ url_character)* }
fragment = { "#" ~ (!"#" ~ url_character)* }
general_url = { http ~ host ~ port? ~ path? ~ query? ~ fragment? }

// End of URL e.g. /path?query#fragment. Keep this repository-specific period rule.
end_of_url = _{ "/" ~ (!("." ~ SP) ~ url_character)* }

// Characters retained by the repository-specific bare-URL recognizer.
url_character = _{
    ASCII_ALPHANUMERIC
    | "-" | "." | "_" | "~" | ":" | "/" | "@" | "?" | "#"
    | "[" | "]" | "!" | "$" | "&" | "'" | "(" | ")" | "*"
    | "+" | "," | ";" | "%" | "="
}

// One-character fallback keeps scanning linear and avoids the previous recursive other rule.
source_char = @{ ANY }
