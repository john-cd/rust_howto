{
    "text-color": "#20262d",
    "background-color": "#f4f6f9",
    "line-number-color": "#667085",
    "line-number-background-color": "#f4f6f9",
    "text-styles": {
        "Alert": { "text-color": "#a61b1b", "bold": true },
        "Annotation": { "text-color": "#7042a0", "italic": true },
        "Attribute": { "text-color": "#8a4600" },
        "BaseN": { "text-color": "#005a9c" },
        "BuiltIn": { "text-color": "#633b8f" },
        "Char": { "text-color": "#12653b" },
        "Comment": { "text-color": "#56616d", "italic": true },
        "CommentVar": { "text-color": "#465363", "bold": true },
        "Constant": { "text-color": "#7b3e8c" },
        "ControlFlow": { "text-color": "#174ea6", "bold": true },
        "DataType": { "text-color": "#8a4600" },
        "DecVal": { "text-color": "#005a9c" },
        "Documentation": { "text-color": "#52606d", "italic": true },
        "Error": { "text-color": "#a61b1b", "bold": true },
        "Extension": { "text-color": "#20262d" },
        "Float": { "text-color": "#005a9c" },
        "Function": { "text-color": "#174ea6", "bold": true },
        "Import": { "text-color": "#633b8f", "bold": true },
        "Information": { "text-color": "#56616d", "italic": true },
        "Keyword": { "text-color": "#633b8f", "bold": true },
        "Operator": { "text-color": "#344054" },
        "Other": { "text-color": "#8a4600" },
        "Preprocessor": { "text-color": "#8a4600" },
        "SpecialChar": { "text-color": "#005a9c", "bold": true },
        "SpecialString": { "text-color": "#12653b" },
        "String": { "text-color": "#12653b" },
        "Variable": { "text-color": "#174c72" },
        "VerbatimString": { "text-color": "#12653b" },
        "Warning": { "text-color": "#8a4600", "bold": true }
    }
}
