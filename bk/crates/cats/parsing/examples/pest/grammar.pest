expression = { SOI ~ term ~ (operator ~ term)* ~ EOI } // Require the whole input.
term = { number }
operator = { "+" | "-" | "*" | "/" } // | matches one of the four strings (either or)
number = @{ ASCII_DIGIT+ } // Atomic rule excludes skipped whitespace from its token.

// This rule starts with a _ and is therefore silent
// (it produces no tokens or error reports).
WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
