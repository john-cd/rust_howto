# Purpose: Expose the Rust book build, example-validation, and maintenance commands.
# Usage: Run just --list from this directory to inspect the available recipes.

# TODO Reviewed ??-??-2026.

import "../scripts/build.just"

# Build and maintain generated book assets with the Bash helper scripts.
mod bash 'scripts/bash'

set shell := ["bash", "-uc"]

# Use Git Bash on Windows; PowerShell scripts are invoked explicitly where needed.
# The sole Windows-to-forward-slash normalization is for SCCACHE_BASEDIRS.

set windows-shell := ["C:/Program Files/Git/bin/bash.exe", "-uc"]

# List the available recipes and task modules.
[no-exit-message]
_default:
    @just --list --unsorted --justfile {{ quote(source_file()) }}

# Uniform task names (short aliases; old names kept as aliases).
alias f := format
alias fa := format-all
alias fc := format-check
alias l := lint
alias lf := lint
alias lint-fix := lint
alias lc := lint-check
alias la := lint-all
alias c := check
alias ca := check-all
alias t := test
alias d := doc
alias p := prep
alias fmtall := format-all
alias cka := check
alias checkall := check
alias ba := build-all
alias buildall := build-all
alias clippyall := lint-check
alias nta := test
alias nextestall := test
alias docall := doc-serve

# Format the current crate
[no-cd]
fmtcurrent:
    @just code fmtcurrent

# Format all packages and their local path-based dependencies
format:
    @just code fmtall

# Format everything (Rust code; use `just mdfmt <path>` for Markdown).
format-all: format

# Check Rust formatting without changing files.
format-check:
    @just code fmtcheck

# Lint all code with autofix (Clippy suggestions applied).
lint:
    @just code clippyfix

# Scan all code for common mistakes without changing files (all features)
lint-check:
    @just code clippyall

# Lint with autofix, then lint the book Markdown.
lint-all: lint lint-md

# Check all code (all features)
check:
    @just code checkall

# Run all checks without modifying files: format, lint, check, test (deny is separate).
check-all: format-check lint-check check test

# Run the local CI gates (the same as check-all).
ci: check-all

# Build the Rust API documentation for the book examples.
doc:
    @just docs _builddocall

# Build and serve the Rust API documentation for the book examples.
doc-serve:
    @just docs docall

# Before pushing: format everything, lint with autofix, then run all checks.
prep: format-all lint check-all

# Format Cargo manifests with cargo-fmt-toml
fmt-toml:
    @just code fmt-toml

# Check code in the current crate (or the default packages of the workspace if in the root) (all features)
[no-cd]
ckc:
    @just code checkcurrent

# Build the package in the current crate (or the default packages of the workspace if in the root) (all features)
[no-cd]
bc:
    @just code buildcurrent

# Build a specific package (all features)
bp pkg:
    @just code buildpkg {{ pkg }}

# Check one package: all targets, all features (fastest feedback loop)
ckp pkg:
    @just code checkpkg {{ pkg }}

# Scan one package for common mistakes (all features)
cap pkg:
    @just code clippypkg {{ pkg }}

# Test one package, including doctests (all features)
ntp pkg:
    @just code nextestpkg {{ pkg }}

# Build all code (default features)
build:
    @just code build

alias b := build

# Build all code (all features)
build-all:
    @just code buildall

# Test only tests that match a given keyword
ntt test:
    @just code nextestthis {{ test }}

# Test in the current directory (or the default packages of the workspace if in the root) (all features)
[no-cd]
ntc:
    @just code nextestcurrent

# Test all code (no doctests) (default features)
nt:
    @just code nextest

# Test all code, including doctests (all features)
test:
    @just code nextestall

# Format, build, lint, and test the Rust book examples.
mod code 'scripts/code'
# Build and open Rust API documentation for the book examples.
mod docs 'scripts/docs'

# Alias for book
bb:
    @just book buildbook

# Alias for book quick
q:
    @just book quick

# Format one book Markdown file or directory with dprint
mdfmt path:
    dprint fmt {{ path }}

# Check one book Markdown file or directory with dprint
mdfmt-check path:
    dprint check {{ path }}

# Lint book, draft, and future Markdown with the pinned markdownlint-cli2
lint-md *args='':
    cd .. && npx --yes markdownlint-cli2@0.24.0 {{ args }}

# Alias for book serve
s:
    @just book serve

# Build, preview, and install the pinned tools for the Rust book.
mod book 'scripts/book'
# Find missing anchors and generate their Markdown reference definitions.
mod anchors 'scripts/anchors'
# Normalize recipe tables in book chapters.
mod recipes 'scripts/recipes'
# Inspect and update the book example dependencies.
mod deps 'scripts/deps'
# Normalize book chapter titles.
mod titles 'scripts/titles'
# Find missing Markdown includes and local reference definitions.
mod includes 'scripts/includes'
# Find, create, and maintain Rust examples used by the book.
mod examples 'scripts/examples'
# Collect, check, sort, and rename Markdown reference definitions.
mod refdefs 'scripts/refdefs'
# Maintain crate links, category links, and cross-references in the book.
mod links 'scripts/links'
# Check external URLs and list duplicate URL references.
mod urls 'scripts/urls'
# Generate crate, language, and example indexes for the book.
mod indices 'scripts/indices'
# Hide and restore book chapters in the table of contents.
mod chapters 'scripts/chapters'
# Find book chapters that are missing from the table of contents.
mod toc 'scripts/toc'
# Check crate names and synchronize crate references in book content.
mod crates 'scripts/crates'

# Alias for utils
u *args='':
    @just utils {{ args }}

# Expose the shared book-maintenance utility task module.
mod utils 'scripts/utils'
# Check book spelling and maintain the project word list.
mod spelling 'scripts/spelling'

# Check book spelling with the supplied command options.
spell extra_param='':
    @just spelling spell {{ extra_param }}

# Backward-compatible alias for lint-md
mdlint *args='':
    @just lint-md {{ args }}

# Generate a Markdown link for paths matching the supplied pattern.
lnk pattern:
    @just utils make_link {{ pattern }}

# Build and publish development images and inspect Compose services.
mod docker 'scripts/docker'
# Manage GitHub issues and validate the issue-refresh helpers.
mod gh 'scripts/gh'
mod? hooks 'scripts/hooks'
# Find and replace wiki-style links in book content.
mod wikilinks 'scripts/wikilinks'

## ---- CLEAN ------------------------------------------

# Clean Cargo's `target` and mdbook's `book` directories
@clean:
    just --justfile "{{ source_directory() }}/scripts/bash/mod.just" clean-doctest-cache
    cargo clean
    mdbook clean

# Verify Windows path quoting and the SCCACHE_BASEDIRS separator/normalization.
[windows]
path-boundary-test:
    pwsh.exe -NoLogo -NoProfile -File {{ quote(source_directory() + "/scripts/tests/test-path-boundaries.ps1") }}

# Internal target used by the path-boundary test to exercise just's PowerShell quoting.
[windows]
_path-boundary-probe value:
    pwsh.exe -NoLogo -NoProfile -File {{ quote(source_directory() + "/scripts/tests/path-boundary-probe.ps1") }} -Value {{ quote(value) }}

## ---- PRE-PUSH -----------------------------------
# Prepare for git push: spell sortrefs fmtall clean clippyall testall _builddocall buildbook
# prep: spell sortrefs fmtall clean clippyall testall docs::_builddocall buildbook
