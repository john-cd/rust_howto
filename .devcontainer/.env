# TODO Reviewed ??-??-2026.

## Version of Rust used to compile the code
RUST_VERSION="1.99.1"

## Label of the base Rust docker image (update Debian release when needed)
RUST_IMAGE_LABEL="${RUST_VERSION:?rust version must be defined}-slim-trixie"

## Version of the mdBook executable
MDBOOK_VERSION="0.5.4"

## Tested mdBook companion tools. Keep mdbook-scrub's mdbook-preprocessor dependency
## (0.5.4 in tools/Cargo.lock) aligned with MDBOOK_VERSION.
MDBOOK_LINKCHECK_VERSION="0.7.7"
MDBOOK_INDEXING_VERSION="0.2.0"
MDBOOK_PANDOC_VERSION="0.11.0"
MDBOOK_UTILS_REV="171a98f93a6d3817561c8dd9f8075a9dcf6629f3"

## Pin the CI helpers installed alongside the book tooling.
CARGO_NEXTEST_VERSION="0.9.148"
JUST_VERSION="1.59.0"
TECTONIC_VERSION="0.17.0"

## Version of the pandoc binary to install (see https://github.com/jgm/pandoc/releases)
PANDOC_VERSION="3.9.0.2"

# Env. variables for Git: https://git-scm.com/book/en/v2/Git-Internals-Environment-Variables
GIT_AUTHOR_NAME="John CD"
EMAIL="john-cd@users.noreply.github.com"

## Version of the Docker image to create e.g. 0.1.0
# IMAGE_VERSION=latest

# https://docs.docker.com/compose/how-tos/dependent-images/
COMPOSE_BAKE=true
