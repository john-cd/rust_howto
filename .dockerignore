# Include any files or directories that you don't want to be copied to the (CI)
# container here (e.g., local build artifacts, temporary files, etc.).
#
# For more help, visit the .dockerignore file reference guide at
# https://docs.docker.com/go/build-context-dockerignore/

# Git and CI
.git/
.github/

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo

# Local worktrees and build/cache links (the build context otherwise grows to gigabytes)
.worktrees/
.sccache
.rumdl_cache/
build/

# Build Artifacts
bin/
**/target/
**/book/
**/doctest_cache/
**/temp/

# Python bits (since python3 is in the Dockerfile)
__pycache__/
*.py[cod]
*$py.class

# Project specific
bk/drafts/
later/
mdbook-utils/
playground/
publish/
typ/
/*.md
/*.html

# Logs and Temp
**/*.log
tmp/

# Repository metadata and worktree state
**/.git/
/.worktrees/
**/.worktrees/

# Rust and native build outputs
/target/
/build/
**/build/
/debug/
**/debug/
/.sccache/
**/.sccache/
*.pdb
*.profraw
*.profdata

# Python caches and environments
**/__pycache__/
**/.venv/
**/.ruff_cache/
**/.pytest_cache/
**/.ipynb_checkpoints/

# CI runner output
/.ci/
**/.ci/

# Secrets and local environment files
**/.env
**/.env.*
!/.env.example
!**/.env.example
