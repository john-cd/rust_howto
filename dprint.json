{
  "includes": [
    "**/*.md",
    "**/*.mdx",
    "**/*.json",
    "**/*.jsonc",
    "**/*.toml",
    "**/*.yaml",
    "**/*.yml",
    "**/Dockerfile"
  ],
  "excludes": [
    "**/.git/**",
    "**/.worktrees/**",
    "**/node_modules/**",
    "**/target/**",
    "mdbook-utils/**",
    "bk/book/**",
    "bk/src/indices/crates_alphabetical.md",
    "bk/src/indices/crates_by_category.md",
    "bk/src/indices/examples_index.md",
    "bk/src/word_index.md"
  ],
  "markdown": {
    "emphasisKind": "underscores",
    "lineWidth": 120,
    "newLineKind": "lf",
    "strongKind": "asterisks",
    "textWrap": "maintain",
    "unorderedListKind": "dashes"
  },
  "plugins": [
    "npm:@dprint/markdown@0.28.0",
    "npm:@dprint/toml@0.9.0",
    "npm:@dprint/json@0.25.2",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/dockerfile@0.7.0"
  ]
}
