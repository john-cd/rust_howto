// TODO Reviewed ??-??-2026

// markdownlint-cli2 configuration for the book content.
// Run `just lint-md` from bk/ (`just mdlint` remains an alias).
{
  "config": { "extends": "bk/.markdownlint.yaml" },
  "globs": [
    "bk/src/**/*.md",
    "bk/drafts/**/*.md",
    "later/src/**/*.md"
  ],
  "ignores": [
    "**/node_modules/**",
    "**/target/**",
    "bk/src/indices/crates_by_category.md",
    "**/refs/dependency-refs.md"
  ],
  "gitignore": true,
  "noBanner": true,
  "noProgress": true
}
