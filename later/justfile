# TODO Reviewed ??-??-2026

import "../scripts/build.just"

set shell := ["bash", "-uc"]

# Set shell for Windows OSs:
# PowerShell Core has some of the Unix shell skills we need, such as || and &&
set windows-shell := ["pwsh.exe", "-NoLogo", "-Command"]

root := source_directory()
code_root := clean(join(root, "crates"))
rustfmt_toolchain_default := trim(replace_regex(read(join(root, "..", "rustfmt-toolchain.toml")), '(?s).*channel\s*=\s*"([^"]+)".*', "$1"))
rustfmt_toolchain_override := env("RUSTFMT_TOOLCHAIN", "")
rustfmt_toolchain := if rustfmt_toolchain_override == "" { rustfmt_toolchain_default } else { rustfmt_toolchain_override }

[no-exit-message]
_default:
  @just --list --unsorted --justfile {{source_file()}}

alias fa := fmtall

# Format all packages and their local path-based dependencies
@fmtall:
  echo "Formatting all packages and their local path-based dependencies in $(pwd)"
  cd {{code_root}}; cargo +{{rustfmt_toolchain}} fmt --all
  cd {{code_root}}/gui_vizia; cargo +{{rustfmt_toolchain}} fmt --all
  cd {{code_root}}/cats/development_tools_ffi/python_extension; cargo +{{rustfmt_toolchain}} fmt --all

alias cka := checkall

# Check all code (all packages, all features)
@checkall:
  echo "Check all code (all packages, all features) in $(pwd)"
  cd {{code_root}}; cargo check --workspace --all-targets --locked --all-features
  cd {{code_root}}/gui_vizia; cargo check --workspace --all-targets --locked --all-features
  cd {{code_root}}/cats/development_tools_ffi/python_extension; cargo check --workspace --all-targets --locked --all-features
# `--all-targets` is equivalent to specifying `--lib --bins --tests --benches --examples`.

alias ba := buildall

# Build all packages (all features)
@buildall:
  echo "Build all packages, all features in $(pwd)"
  cd {{code_root}}; cargo build --workspace --all-targets --locked --all-features --timings
  cd {{code_root}}/gui_vizia; cargo build --workspace --all-targets --locked --all-features
  cd {{code_root}}/cats/development_tools_ffi/python_extension; cargo build --workspace --all-targets --locked --all-features

alias ca := clippyall

# Scan all code for common mistakes (all packages, all features)
@clippyall:
  echo "Scan all code for common mistakes (all packages, all features) in $(pwd)"
  # sccache 0.18.0 expands web-sys rustc arguments past Windows' process limit.
  cd {{code_root}}; cargo clippy --workspace --exclude wasm --all-targets --locked --all-features -- -D warnings
  cd {{code_root}}; $env:RUSTC_WRAPPER = ""; cargo clippy --package wasm --all-targets --locked --all-features -- -D warnings
  cd {{code_root}}/gui_vizia; cargo clippy --workspace --all-targets --locked --all-features -- -D warnings
  cd {{code_root}}/cats/development_tools_ffi/python_extension; cargo clippy --workspace --all-targets --locked --all-features -- -D warnings

alias nta := nextestall

# Test all code in the workspace (incl. doctests) (all features)
@nextestall:
  echo "Test all code in the workspace in $(pwd) (incl. doctests) (all features)"
  # sccache expands wasm's web-sys rustc arguments past Windows' process command-line limit.
  cd {{code_root}}; cargo test --doc --workspace --exclude wasm --all-features --locked
  cd {{code_root}}; cargo nextest run --workspace --exclude wasm --all-targets --locked --no-fail-fast --status-level all --all-features
  cd {{code_root}}; $env:RUSTC_WRAPPER = ""; cargo nextest run --package wasm --all-targets --locked --no-fail-fast --status-level all --all-features

# Build and display the `cargo doc` documentation
@docall:
  echo "Build and display the `cargo doc` documentation for $(pwd)"
  cd {{code_root}}; cargo clean --doc
  cd {{code_root}}; cargo doc --no-deps --workspace --locked --document-private-items
  cd ../target/later/doc/ ; python3 -m http.server 9000
