# Purpose: Build, validate, and maintain this Rust workspace with its configured tooling environment.
# Usage: Run just --list from this directory to inspect the available recipes.

# TODO Reviewed ??-??-2026.

import "../scripts/build.just"

set shell := ["bash", "-uc"]

# Use Git Bash on Windows so recipes share one shell syntax across platforms.
set windows-shell := ["C:/Program Files/Git/bin/bash.exe", "-uc"]

root := replace(source_directory(), "\\", "/")
code_root := quote(clean(join(root, "crates")))
ffi_features_without_module := "cpp,erlang,flutter,java,lua,node,objc,ruby,uniffi"
ffi_features_for_linking := "cpp,erlang,flutter,java,lua,node,objc,uniffi"
rustfmt_toolchain_default := trim(replace_regex(read(join(root, "..", "rustfmt-toolchain.toml")), '(?s).*channel\s*=\s*"([^"]+)".*', "$1"))
rustfmt_toolchain_override := env("RUSTFMT_TOOLCHAIN", "")
rustfmt_toolchain := if rustfmt_toolchain_override == "" { rustfmt_toolchain_default } else { rustfmt_toolchain_override }

# List the available recipes and task modules.
[no-exit-message]
_default:
    @just --list --unsorted --justfile {{ quote(source_file()) }}

# Format all Rust packages and their local path dependencies. Alias: fa.
alias fa := fmtall

# Format all packages and their local path-based dependencies
@fmtall:
    echo "Formatting all packages and their local path-based dependencies in $(pwd)"
    cd {{ code_root }}; cargo +{{ rustfmt_toolchain }} fmt --all
    cd {{ code_root }}/cats/gui/vizia; cargo +{{ rustfmt_toolchain }} fmt --all
    cd {{ code_root }}/cats/development_tools_ffi/python_extension; cargo +{{ rustfmt_toolchain }} fmt --all

# Check all Rust targets with every configured feature. Alias: cka.
alias cka := checkall

# Check all code (all packages, all features)
@checkall:
    echo "Check all code (all packages, all features) in $(pwd)"
    # science_robotics needs a sourced ROS installation; science_geo needs GEOS.
    # mlua-sys requires `vendored` and `module` in separate feature sets.
    cd {{ code_root }}; RUSTC_WRAPPER= CARGO_BUILD_RUSTC_WRAPPER= CARGO_INCREMENTAL=1 cargo check --workspace --exclude science_robotics --exclude science_geo --exclude development_tools_ffi --all-targets --locked --all-features
    cd {{ code_root }}; NO_LINK_RUTIE=1 RUSTC_WRAPPER= CARGO_BUILD_RUSTC_WRAPPER= CARGO_INCREMENTAL=1 cargo check --package development_tools_ffi --all-targets --locked --features {{ quote(ffi_features_without_module) }}
    cd {{ code_root }}; RUSTC_WRAPPER= CARGO_BUILD_RUSTC_WRAPPER= CARGO_INCREMENTAL=1 cargo check --package development_tools_ffi --all-targets --locked --features lua-module
    cd {{ code_root }}/cats/gui/vizia; RUSTC_WRAPPER= CARGO_BUILD_RUSTC_WRAPPER= CARGO_INCREMENTAL=1 cargo check --workspace --all-targets --locked --all-features
    cd {{ code_root }}/cats/development_tools_ffi/python_extension; RUSTC_WRAPPER= CARGO_BUILD_RUSTC_WRAPPER= CARGO_INCREMENTAL=1 cargo check --workspace --all-targets --locked --all-features
# `--all-targets` is equivalent to specifying `--lib --bins --tests --benches --examples`.

# Build all Rust targets with every configured feature. Alias: ba.
alias ba := buildall

# Build all packages (all features)
@buildall:
    echo "Build all packages, all features in $(pwd)"
    # science_robotics requires ROS, science_geo requires GEOS, and the FFI
    # Ruby example requires Ruby development libraries for linking.
    # mlua-sys requires `vendored` and `module` in separate feature sets.
    cd {{ code_root }}; RUSTC_WRAPPER= CARGO_BUILD_RUSTC_WRAPPER= CARGO_INCREMENTAL=1 cargo build --workspace --exclude science_robotics --exclude science_geo --exclude development_tools_ffi --all-targets --locked --all-features --timings
    cd {{ code_root }}; RUSTC_WRAPPER= CARGO_BUILD_RUSTC_WRAPPER= CARGO_INCREMENTAL=1 cargo build --package development_tools_ffi --all-targets --locked --features {{ quote(ffi_features_for_linking) }}
    cd {{ code_root }}; RUSTC_WRAPPER= CARGO_BUILD_RUSTC_WRAPPER= CARGO_INCREMENTAL=1 cargo build --package development_tools_ffi --all-targets --locked --features lua-module
    cd {{ code_root }}/cats/gui/vizia; RUSTC_WRAPPER= CARGO_BUILD_RUSTC_WRAPPER= CARGO_INCREMENTAL=1 cargo build --workspace --all-targets --locked --all-features
    cd {{ code_root }}/cats/development_tools_ffi/python_extension; RUSTC_WRAPPER= CARGO_BUILD_RUSTC_WRAPPER= CARGO_INCREMENTAL=1 cargo build --workspace --all-targets --locked --all-features

# Lint all Rust targets and features with Clippy. Alias: ca.
alias ca := clippyall

# Scan all code for common mistakes (all packages, all features)
@clippyall:
    echo "Scan all code for common mistakes (all packages, all features) in $(pwd)"
    # sccache 0.18.0 expands web-sys rustc arguments past Windows' process limit.
    # science_robotics needs ROS; science_geo needs GEOS and pkg-config.
    # mlua-sys requires `vendored` and `module` in separate feature sets.
    cd {{ code_root }}; RUSTC_WRAPPER= CARGO_BUILD_RUSTC_WRAPPER= CARGO_INCREMENTAL=1 cargo clippy --workspace --exclude wasm --exclude science_robotics --exclude science_geo --exclude development_tools_ffi --all-targets --locked --all-features -- -D warnings
    cd {{ code_root }}; NO_LINK_RUTIE=1 RUSTC_WRAPPER= CARGO_BUILD_RUSTC_WRAPPER= CARGO_INCREMENTAL=1 cargo clippy --package development_tools_ffi --all-targets --locked --features {{ quote(ffi_features_without_module) }} -- -D warnings
    cd {{ code_root }}; NO_LINK_RUTIE=1 RUSTC_WRAPPER= CARGO_BUILD_RUSTC_WRAPPER= CARGO_INCREMENTAL=1 cargo clippy --package development_tools_ffi --all-targets --locked --features lua-module -- -D warnings
    cd {{ code_root }}; RUSTC_WRAPPER= CARGO_BUILD_RUSTC_WRAPPER= CARGO_INCREMENTAL=1 cargo clippy --package wasm --all-targets --locked --all-features -- -D warnings
    cd {{ code_root }}/cats/gui/vizia; RUSTC_WRAPPER= CARGO_BUILD_RUSTC_WRAPPER= CARGO_INCREMENTAL=1 cargo clippy --workspace --all-targets --locked --all-features -- -D warnings
    cd {{ code_root }}/cats/development_tools_ffi/python_extension; RUSTC_WRAPPER= CARGO_BUILD_RUSTC_WRAPPER= CARGO_INCREMENTAL=1 cargo clippy --workspace --all-targets --locked --all-features -- -D warnings

# Run the configured workspace tests and doctests. Alias: nta.
alias nta := nextestall

# Test all code in the workspace (incl. doctests) (all features)
@nextestall:
    echo "Test all code in the workspace in $(pwd) (incl. doctests) (all features)"
    # sccache expands wasm's web-sys rustc arguments past Windows' process command-line limit.
    # mlua-sys requires `vendored` and `module` in separate feature sets.
    cd {{ code_root }}; RUSTC_WRAPPER= CARGO_BUILD_RUSTC_WRAPPER= CARGO_INCREMENTAL=1 cargo test --doc --workspace --exclude wasm --exclude science_robotics --exclude science_geo --exclude development_tools_ffi --all-features --locked
    cd {{ code_root }}; RUSTC_WRAPPER= CARGO_BUILD_RUSTC_WRAPPER= CARGO_INCREMENTAL=1 cargo test --doc --package development_tools_ffi --locked --features {{ quote(ffi_features_for_linking) }}
    cd {{ code_root }}; RUSTC_WRAPPER= CARGO_BUILD_RUSTC_WRAPPER= CARGO_INCREMENTAL=1 cargo test --doc --package development_tools_ffi --locked --features lua-module
    cd {{ code_root }}; RUSTC_WRAPPER= CARGO_BUILD_RUSTC_WRAPPER= CARGO_INCREMENTAL=1 cargo nextest run --workspace --exclude wasm --exclude science_robotics --exclude science_geo --exclude development_tools_ffi --all-targets --locked --no-fail-fast --status-level all --all-features
    cd {{ code_root }}; RUSTC_WRAPPER= CARGO_BUILD_RUSTC_WRAPPER= CARGO_INCREMENTAL=1 cargo nextest run --package development_tools_ffi --all-targets --locked --no-fail-fast --status-level all --features {{ quote(ffi_features_for_linking) }}
    cd {{ code_root }}; RUSTC_WRAPPER= CARGO_BUILD_RUSTC_WRAPPER= CARGO_INCREMENTAL=1 cargo test --package development_tools_ffi --all-targets --locked --features lua-module
    cd {{ code_root }}; RUSTC_WRAPPER= CARGO_BUILD_RUSTC_WRAPPER= CARGO_INCREMENTAL=1 cargo nextest run --package wasm --all-targets --locked --no-fail-fast --status-level all --all-features

# Build and display the `cargo doc` documentation
@docall:
    echo "Build and display the `cargo doc` documentation for $(pwd)"
    cd {{ code_root }}; cargo clean --doc
    cd {{ code_root }}; cargo doc --no-deps --workspace --locked --document-private-items
    cd ../target/later/doc/ ; python3 -m http.server 9000
