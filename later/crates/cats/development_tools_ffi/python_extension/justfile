# Purpose: Run this Python project with its configured environment and external output directories.
# Usage: Run just --list from this directory to inspect the available recipes.

# Python tasks for later/crates/cats/development_tools_ffi/python_extension.
import '../../../../../scripts/env.just'
# py_project_path is repository-relative and scopes source, cache, and output paths.
# py_environment_project selects the locked dependency environment; set it to a shared
# project key when sibling tools should reuse that project's virtual environment.

py_project_path := "later/crates/cats/development_tools_ffi/python_extension"
py_environment_project := "later/crates/cats/development_tools_ffi/python_extension"
# A separate lightweight environment lets Ruff run without installing/building the extension.
py_lint_environment := replace(join(CODE_PYTHON_ENV_ROOT, py_environment_key + "-lint"), "\\", "/")

# List the available project recipes.
default:
    @just --justfile {{quote(justfile())}} --list

# Format the project Python files with Ruff.
fmt: _python-lint-prepare
    UV_PROJECT_ENVIRONMENT={{quote(py_lint_environment)}} uv --directory {{quote(py_project_dir)}} run --locked --no-sync ruff format .

# Check Python formatting without changing files.
fmt-check: _python-lint-prepare
    UV_PROJECT_ENVIRONMENT={{quote(py_lint_environment)}} uv --directory {{quote(py_project_dir)}} run --locked --no-sync ruff format --check .

# Lint the project Python files with Ruff.
lint: _python-lint-prepare
    UV_PROJECT_ENVIRONMENT={{quote(py_lint_environment)}} uv --directory {{quote(py_project_dir)}} run --locked --no-sync ruff check .

# Build and install the Python extension in the configured environment.
build: _python-prepare
    uv --directory {{quote(py_project_dir)}} build --locked --out-dir {{quote(CODE_PYTHON_OUTPUT_DIR + "/dist")}}

# Synchronize only Ruff into a separate environment, without building the extension.
_python-lint-prepare: _python-prepare
    UV_PROJECT_ENVIRONMENT={{quote(py_lint_environment)}} uv --directory {{quote(py_project_dir)}} sync --locked --only-group lint --no-install-project

# Check Python formatting and lint the project code.
check: _python-lint-prepare
    UV_PROJECT_ENVIRONMENT={{quote(py_lint_environment)}} uv --directory {{quote(py_project_dir)}} run --locked --no-sync ruff format --check .
    UV_PROJECT_ENVIRONMENT={{quote(py_lint_environment)}} uv --directory {{quote(py_project_dir)}} run --locked --no-sync ruff check .
